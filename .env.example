# Modele de configuration du deploiement. Copier en .env (ignore par Git) et remplacer chaque valeur.
# Aucune valeur de ce fichier ne doit etre utilisee telle quelle en dehors du poste de developpement.

# --- PostgreSQL ---
POSTGRES_DB=internatadmin
POSTGRES_USER=internatadmin
POSTGRES_PASSWORD=changer-moi

# --- JWT HS256 : cle encodee en base64, 256 bits minimum (openssl rand -base64 32) ---
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# --- Compte admin initial : hash BCrypt genere depuis backend-ci avec ./scripts/hash-admin-password.sh ---
# Toujours entre apostrophes simples dans .env : sinon le shell interprete les $ du hash.
ADMIN_INITIAL_PASSWORD_HASH=

# --- CORS : origine du frontend publie (doit correspondre a FRONTEND_PORT ci-dessous) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Port publie sur l'hote pour le frontend (seul service expose) ---
FRONTEND_PORT=8080

# --- Images Docker Hub (celles publiees par les pipelines Jenkins T07/T08) ---
BACKEND_IMAGE=abdoulaye940/daara-backend
BACKEND_TAG=latest
FRONTEND_IMAGE=abdoulaye940/daara-frontend
FRONTEND_TAG=latest
